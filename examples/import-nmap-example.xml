<?xml version="1.0"?>
<nmaprun>
  <host>
    <address addr="127.0.0.1" addrtype="ipv4" />
    <hostnames>
      <hostname name="localhost" />
    </hostnames>
    <ports>
      <port protocol="tcp" portid="80">
        <state state="closed" />
        <service name="http" />
      </port>
      <port protocol="tcp" portid="8080">
        <state state="open" />
        <service name="http-proxy" product="AI Web Auditor Lab" version="0.23" />
      </port>
    </ports>
  </host>
</nmaprun>
